<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="12dp"
    android:background="#18202B" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:id="@+id/widgetTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="⚔ DUNGEON WIDGET" android:textColor="#E9D49A" android:textSize="15sp" android:textStyle="bold"/>
    <ImageView android:id="@+id/widgetScene" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="Dungeon scene"/>
    <TextView android:id="@+id/widgetStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#E3E9ED" android:textSize="12sp" android:maxLines="2"/>
    <TextView android:id="@+id/widgetAction" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="⏸ Пауза / ▶ Продолжить" android:gravity="center" android:padding="5dp"
        android:textColor="#E9D49A" android:background="#2E3A49" android:textSize="12sp"/>
</LinearLayout>